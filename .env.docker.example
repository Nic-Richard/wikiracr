# API settings for `docker compose up`. Database paths are fixed inside the image.
CLIENT_URL=http://localhost:8080
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Discord alerts relay. Empty turns alerts off.
ALERTS_URL=
ALERTS_SECRET=
ALERTS_ACTION_SECRET=

# Google Play billing stays off unless these are set.
PLAY_BILLING_ENABLED=false
PLAY_LIVE_APPROVED=false
